{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Karpa",
  "version": "1.3.7",
  "identifier": "app.karpa.translator",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:7250",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Karpa",
        "width": 1280,
        "height": 800,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* https://*; font-src 'self'; img-src 'self' data: blob:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
